{
  "moduleFileExtensions": ["js", "json", "ts"],
  "roots": [".", "../test"],
  "rootDir": "../src",
  "testEnvironment": "node",
  "testRegex": ["e2e/app\\.e2e-spec\\.ts$", "unit/app\\.spec\\.ts$"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "collectCoverageFrom": ["**/*.ts", "!main.ts", "!**/*-res.dto.ts", "!**/*-req.dto.ts"],
  "coverageDirectory": "coverage",
  "coverageReporters": ["html", "lcov", "text-summary"],
  // After way to much time discussing with Claude, he told me "wtf bro, just put forceExit, that's a weird thing with jest & nest, don't ask"
  "forceExit": true
}
